"""
Snakefile — Bacterial Evolution & Health Pipeline
===================================================
End-to-end: SRA accession list → per-species coverage matrices.

Designed to run on ANY SLURM cluster. All cluster-specific settings
(partitions, accounts, thread counts) are read from config/config.yaml.

Submit the orchestrator with:
    sbatch run_pipeline.sh

Or from a tmux/screen session:
    bash run_pipeline.sh
"""

# =========================================================================
# Configuration
# =========================================================================
configfile: "config/config.yaml"

import os
import re

# =========================================================================
# Read cluster settings from config
# =========================================================================
PART_CPU      = config.get("partition_cpu",      "shared")
PART_SHARED   = config.get("partition_shared",   "shared")
PART_DOWNLOAD = config.get("partition_download", PART_CPU)
SLURM_ACCOUNT = config.get("slurm_account",     "")

ALIGN_THREADS   = int(config.get("align_threads",      20))
PREPROC_THREADS = int(config.get("preprocess_threads", 8))

# =========================================================================
# Intermediate file cleanup
# =========================================================================
# By default, intermediate files are deleted after downstream rules succeed.
# Repaired reads, coverage files, and final outputs are always kept.
# Set keep_all: true in config.yaml to disable cleanup entirely.
# =========================================================================
KEEP_ALL = config.get("keep_all", False)
KEEP_REPAIRED_READS = config.get("keep_repaired_reads", True)
KEEP_FILTERED_BAMS = config.get("keep_filtered_bams", True)

def intermediate(path):
    """Mark a file for automatic deletion after it's no longer needed.
    Disabled when keep_all: true is set in config."""
    return path if KEEP_ALL else temp(path)

def checkpoint(path, keep_flag):
    """Mark a file as a configurable checkpoint.
    Kept when keep_flag is True or keep_all is True; otherwise temp."""
    return path if (keep_flag or KEEP_ALL) else temp(path)

# =========================================================================
# Sample discovery
# =========================================================================
# Auto-detects SRA accessions (SRR*, ERR*, DRR*) from ANY file format:
#   - One accession per line
#   - Tab/space-delimited with accession in any column
#   - Metadata tables with headers
#   - Lines starting with # are ignored
# =========================================================================
SAMPLES_TSV = config["samples_tsv"]
SRA_PATTERN = re.compile(r'\b([SED]RR\d{6,})\b')

def load_samples():
    """Scan the samples file for SRA accession IDs in any format."""
    accessions = []
    seen = set()
    with open(SAMPLES_TSV) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            for match in SRA_PATTERN.findall(line):
                if match not in seen:
                    accessions.append(match)
                    seen.add(match)
    return accessions

SAMPLES = load_samples()
print(f"[Pipeline] {len(SAMPLES)} samples auto-detected from {SAMPLES_TSV}")


# =========================================================================
# Derived paths
# =========================================================================
RESULTS   = config.get("results_dir", "results")
REF_DIR   = f"{RESULTS}/references"
FASTQ_DIR = f"{RESULTS}/fastq"
PHIX_IDX  = f"{REF_DIR}/phix/phix"
HUMAN_IDX = f"{REF_DIR}/human/hg38"
META_IDX  = f"{REF_DIR}/metagenome/reference"


# =========================================================================
# TARGET — the final outputs
# =========================================================================
rule all:
    input:
        # Per-sample CSVs
        expand(f"{RESULTS}/aggregated/{{sample}}_depth_and_coverage_stats.csv",
               sample=SAMPLES),
        # Combined matrices (the ultimate deliverables)
        f"{RESULTS}/matrices/depth_matrix.csv",
        f"{RESULTS}/matrices/coverage_matrix.csv",


# =========================================================================
#               REFERENCE PREPARATION (runs once)
# =========================================================================
# These five rules download reference genomes and build Bowtie2 indices.
# They run exactly once. On re-runs, Snakemake sees outputs exist and skips.
# If you already have indices, create the sentinel files:
#     mkdir -p results/references/{phix,human,metagenome}
#     touch results/references/{phix,human,metagenome}/.index_done
# =========================================================================

rule download_phix:
    """Download PhiX174 genome from NCBI."""
    output: fasta = f"{REF_DIR}/phix/phix.fna"
    params:
        url = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/819/615/GCF_000819615.1_ViralProj14015/GCF_000819615.1_ViralProj14015_genomic.fna.gz",
    resources:
        mem_mb    = 2000,
        runtime   = 30,
        slurm_partition = PART_DOWNLOAD,
    log: "logs/ref/download_phix.log"
    shell:
        """
        mkdir -p $(dirname {output.fasta})
        curl -fSL {params.url} 2> {log} | gunzip -c > {output.fasta}
        """


rule build_phix_index:
    input:  fasta = f"{REF_DIR}/phix/phix.fna"
    output: sentinel = f"{REF_DIR}/phix/.index_done"
    params: idx = PHIX_IDX
    threads: 4
    resources:
        mem_mb    = 4000,
        runtime   = 30,
        slurm_partition = PART_CPU,
    log: "logs/ref/build_phix.log"
    shell:
        """
        bowtie2-build --threads {threads} {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


rule download_human:
    """Download GRCh38 (hg38) from NCBI. ~3 GB compressed, ~3.1 GB uncompressed."""
    output: fasta = f"{REF_DIR}/human/hg38.fna"
    params:
        url = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/405/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.fna.gz",
    resources:
        mem_mb    = 4000,
        runtime   = 120,
        slurm_partition = PART_DOWNLOAD,
    log: "logs/ref/download_human.log"
    shell:
        """
        mkdir -p $(dirname {output.fasta})
        curl -fSL {params.url} 2> {log} | gunzip -c > {output.fasta}
        """


rule build_human_index:
    """Build hg38 Bowtie2 large index. ~2-3 hours, ~60 GB RAM, runs once."""
    input:  fasta = f"{REF_DIR}/human/hg38.fna"
    output: sentinel = f"{REF_DIR}/human/.index_done"
    params: idx = HUMAN_IDX
    threads: 8
    resources:
        mem_mb    = 65000,
        runtime   = 300,
        slurm_partition = PART_CPU,
    log: "logs/ref/build_human.log"
    shell:
        """
        bowtie2-build --threads {threads} --large-index \
            {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


rule build_metagenome_index:
    """Build Bowtie2 large index from your reference metagenome FASTA."""
    input:  fasta = config["reference_fasta"]
    output: sentinel = f"{REF_DIR}/metagenome/.index_done"
    params: idx = META_IDX
    threads: 8
    resources:
        mem_mb    = 65000,
        runtime   = 300,
        slurm_partition = PART_CPU,
    log: "logs/ref/build_metagenome.log"
    shell:
        """
        mkdir -p $(dirname {params.idx})
        bowtie2-build --threads {threads} --large-index \
            {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


# =========================================================================
#                   STAGE 1: SRA DOWNLOAD
# =========================================================================
# One job per sample. prefetch → fasterq-dump → pigz.
# Uses the "download" partition (may need internet access).
# If you already have FASTQs, symlink them into results/fastq/ and these
# rules are skipped automatically.
# =========================================================================

rule sra_download:
    """Download one paired-end sample from NCBI SRA."""
    output:
        r1 = intermediate(f"{FASTQ_DIR}/{{sample}}_1.fastq.gz"),
        r2 = intermediate(f"{FASTQ_DIR}/{{sample}}_2.fastq.gz"),
    params:
        sra_cache = f"{RESULTS}/.sra_cache",
        fastq_dir = FASTQ_DIR,
        max_size  = config.get("prefetch_max_size", "300G"),
    threads: 6
    retries: 2
    resources:
        mem_mb    = lambda wc, attempt: 10000 * attempt,
        runtime   = lambda wc, attempt: 300 * attempt,
        slurm_partition = PART_DOWNLOAD,
    log: "logs/01_download/{sample}.log"
    shell:
        """
        set -euo pipefail
        WDIR=$(pwd)
        mkdir -p {params.sra_cache} {params.fastq_dir} "$(dirname "$WDIR/{log}")"
        cd {params.sra_cache}

        echo "=== Downloading {wildcards.sample} ===" > "$WDIR/{log}"

        # prefetch (caches .sra, supports resume on retry)
        prefetch --max-size {params.max_size} {wildcards.sample} 2>> "$WDIR/{log}"

        # fasterq-dump (converts .sra → paired .fastq)
        fasterq-dump {wildcards.sample} \
            --split-files --progress --threads {threads} \
            --outdir "$WDIR/{params.fastq_dir}" \
            2>> "$WDIR/{log}"

        # Compress with pigz (parallel gzip)
        for f in "$WDIR/{params.fastq_dir}/{wildcards.sample}"{{,_1,_2}}.fastq; do
            [ -f "$f" ] && pigz -p {threads} "$f" 2>> "$WDIR/{log}" || true
        done

        # Clean up cached .sra
        rm -rf {params.sra_cache}/{wildcards.sample} 2>> "$WDIR/{log}" || true

        # Verify paired outputs
        [ -f "$WDIR/{output.r1}" ] && [ -f "$WDIR/{output.r2}" ] || \
            {{ echo "ERROR: paired outputs missing for {wildcards.sample}" >> "$WDIR/{log}"; exit 1; }}

        echo "=== Done {wildcards.sample} ===" >> "$WDIR/{log}"
        """


# =========================================================================
#                   STAGE 2: PREPROCESSING
# =========================================================================
# trim_galore → bowtie2 vs PhiX → bowtie2 vs hg38 → BBTools repair
#
# Each step is a separate rule for:
#   - Independent failure/retry (OOM in human removal doesn't redo trimming)
#   - Automatic resource scaling per step
#   - intermediate() cleanup (safe: only after downstream succeeds)
#     Disabled when keep_all: true in config.yaml
# =========================================================================

rule trim_galore:
    """Adapter + quality trimming."""
    input:
        r1 = f"{FASTQ_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{FASTQ_DIR}/{{sample}}_2.fastq.gz",
    output:
        r1 = intermediate(f"{RESULTS}/trimmed/{{sample}}_1_val_1.fq.gz"),
        r2 = intermediate(f"{RESULTS}/trimmed/{{sample}}_2_val_2.fq.gz"),
    params:
        outdir = f"{RESULTS}/trimmed",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 2)) * attempt,
        runtime   = lambda wc, input, attempt: max(60,   int(input.size_mb / 80)) * attempt,
        slurm_partition = PART_CPU,
    log: "logs/02_trim/{sample}.log"
    shell:
        """
        mkdir -p {params.outdir}
        trim_galore -j {threads} --paired \
            --output_dir {params.outdir} \
            {input.r1} {input.r2} \
            &> {log}
        """


rule remove_phix:
    """Remove PhiX spike-in contamination."""
    input:
        r1       = f"{RESULTS}/trimmed/{{sample}}_1_val_1.fq.gz",
        r2       = f"{RESULTS}/trimmed/{{sample}}_2_val_2.fq.gz",
        idx_done = f"{REF_DIR}/phix/.index_done",
    output:
        r1 = intermediate(f"{RESULTS}/decontam/{{sample}}_1_phiX_removed.fq.gz"),
        r2 = intermediate(f"{RESULTS}/decontam/{{sample}}_2_phiX_removed.fq.gz"),
    params:
        idx    = PHIX_IDX,
        prefix = f"{RESULTS}/decontam/{{sample}}_%_phiX_removed.fq.gz",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 2)) * attempt,
        runtime   = lambda wc, input, attempt: max(30,   int(input.size_mb / 80)) * attempt,
        slurm_partition = PART_CPU,
    log: "logs/02_phix/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {params.prefix})
        bowtie2 -p {threads} \
            --un-conc-gz {params.prefix} \
            -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --no-unal \
            > /dev/null 2> {log}
        """


rule remove_human:
    """Remove human host reads by aligning to hg38."""
    input:
        r1       = f"{RESULTS}/decontam/{{sample}}_1_phiX_removed.fq.gz",
        r2       = f"{RESULTS}/decontam/{{sample}}_2_phiX_removed.fq.gz",
        idx_done = f"{REF_DIR}/human/.index_done",
    output:
        r1 = intermediate(f"{RESULTS}/decontam/{{sample}}_1_human_removed.fq.gz"),
        r2 = intermediate(f"{RESULTS}/decontam/{{sample}}_2_human_removed.fq.gz"),
    params:
        idx    = HUMAN_IDX,
        prefix = f"{RESULTS}/decontam/{{sample}}_%_human_removed.fq.gz",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        # Human genome alignment needs more memory than PhiX
        mem_mb    = lambda wc, input, attempt: max(16000, int(input.size_mb * 3)) * attempt,
        runtime   = lambda wc, input, attempt: max(120,   int(input.size_mb / 50)) * attempt,
        slurm_partition = PART_CPU,
    log: "logs/02_human/{sample}.log"
    shell:
        """
        bowtie2 -p {threads} \
            --un-conc-gz {params.prefix} \
            -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --no-unal \
            > /dev/null 2> {log}
        """


rule repair_mates:
    """Re-synchronize mate pairs after decontamination."""
    input:
        r1 = f"{RESULTS}/decontam/{{sample}}_1_human_removed.fq.gz",
        r2 = f"{RESULTS}/decontam/{{sample}}_2_human_removed.fq.gz",
    output:
        # Configurable checkpoint — kept by default for re-alignment flexibility
        r1 = checkpoint(f"{RESULTS}/repaired/{{sample}}_1_repaired.fq.gz", KEEP_REPAIRED_READS),
        r2 = checkpoint(f"{RESULTS}/repaired/{{sample}}_2_repaired.fq.gz", KEEP_REPAIRED_READS),
    params:
        singles_tmp = f"{RESULTS}/repaired/{{sample}}_singles.fq.gz",
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 3)) * attempt,
        runtime   = lambda wc, input, attempt: max(30,   int(input.size_mb / 80)) * attempt,
        slurm_partition = PART_CPU,
    log: "logs/02_repair/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {output.r1})
        repair.sh \
            in1={input.r1} in2={input.r2} \
            out1={output.r1} out2={output.r2} \
            outs={params.singles_tmp} \
            qin=33 \
            &> {log}
        # Remove singles file — empty for properly paired data
        rm -f {params.singles_tmp}
        """


# =========================================================================
#                     STAGE 3: ALIGNMENT
# =========================================================================
# Bowtie2 --very-sensitive-local piped directly to samtools sort.
# No intermediate SAM on disk (saves massive disk space).
# =========================================================================

rule align:
    """Align cleaned reads to metagenome reference → sorted BAM (no intermediate SAM)."""
    input:
        r1       = f"{RESULTS}/repaired/{{sample}}_1_repaired.fq.gz",
        r2       = f"{RESULTS}/repaired/{{sample}}_2_repaired.fq.gz",
        idx_done = f"{REF_DIR}/metagenome/.index_done",
    output:
        bam = intermediate(f"{RESULTS}/aligned/{{sample}}.sorted.bam"),
        bai = intermediate(f"{RESULTS}/aligned/{{sample}}.sorted.bam.bai"),
    params:
        idx = META_IDX,
    threads: ALIGN_THREADS
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(20000, int(input.size_mb * 5)) * attempt,
        runtime   = lambda wc, input, attempt: max(120,   int(input.size_mb / 20)) * attempt,
        slurm_partition = PART_CPU,
    log: "logs/03_align/{sample}.log"
    shell:
        # Pipe: bowtie2 → samtools view → samtools sort
        # samtools gets 4 threads each; bowtie2 gets the rest
        """
        set -o pipefail

        (bowtie2 -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --very-sensitive-local \
            -p {threads} \
        | samtools view -Sb --threads 4 - \
        | samtools sort -o {output.bam} --threads 4 -m 2G \
        ) 2> {log}

        samtools index -@ 4 {output.bam} 2>> {log}
        """


# =========================================================================
#                   STAGE 4: MAPQ FILTERING
# =========================================================================
# Single-pass MAPQ split: high (≥ threshold) and low (< threshold).
# Uses samtools view -q with -U for the complement — one read of the BAM.
# =========================================================================

rule filter_mapq:
    """Single-pass BAM split into high/low MAPQ."""
    input:
        bam = f"{RESULTS}/aligned/{{sample}}.sorted.bam",
    output:
        high = checkpoint(f"{RESULTS}/filtered/high/{{sample}}_high_mapq.bam", KEEP_FILTERED_BAMS),
        low  = checkpoint(f"{RESULTS}/filtered/low/{{sample}}_low_mapq.bam", KEEP_FILTERED_BAMS),
    params:
        mapq = config.get("mapq_threshold", 30),
    threads: 4
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 1.5)) * attempt,
        runtime   = lambda wc, input, attempt: max(30,   int(input.size_mb / 200)) * attempt,
        slurm_partition = PART_SHARED,
    log: "logs/04_filter/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {output.high}) $(dirname {output.low})
        samtools view -b -q {params.mapq} \
            -U {output.low} \
            -o {output.high} \
            {input.bam} \
            2> {log}
        samtools quickcheck {output.high} {output.low} 2>> {log}
        """


# =========================================================================
#               STAGE 5: COVERAGE EXTRACTION
# =========================================================================
# samtools coverage → per-contig depth + breadth of coverage.
# Uses {tier} wildcard to handle both "high" and "low" with one rule.
# Coverage files are always kept (small; useful for downstream analysis).
# =========================================================================

rule extract_coverage:
    """Per-contig coverage statistics with samtools coverage."""
    input:
        bam = f"{RESULTS}/filtered/{{tier}}/{{sample}}_{{tier}}_mapq.bam",
    output:
        cov = f"{RESULTS}/coverage/{{tier}}/{{sample}}_{{tier}}_mapq_coverage.txt",
    threads: 1
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(4000, int(input.size_mb * 1.5)) * attempt,
        runtime   = lambda wc, input, attempt: max(30,   int(input.size_mb / 100)) * attempt,
        slurm_partition = PART_SHARED,
    log: "logs/05_coverage/{tier}/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {output.cov})
        samtools quickcheck -v {input.bam} 2> {log}
        samtools coverage -o {output.cov} {input.bam} 2>> {log}
        """


# =========================================================================
#             STAGE 6: COVERAGE AGGREGATION
# =========================================================================
# Python: aggregates contig-level → species-level with length weighting.
# Very lightweight — mostly pandas operations in memory.
# =========================================================================

rule aggregate_coverage:
    """Aggregate per-contig coverage to per-species weighted statistics."""
    input:
        cov = f"{RESULTS}/coverage/high/{{sample}}_high_mapq_coverage.txt",
    output:
        csv = f"{RESULTS}/aggregated/{{sample}}_depth_and_coverage_stats.csv",
    params:
        contig_map = config["contig_to_species"],
        input_dir  = f"{RESULTS}/coverage/high",
        output_dir = f"{RESULTS}/aggregated",
    threads: 1
    resources:
        mem_mb    = 16000,
        runtime   = 60,
        slurm_partition = PART_SHARED,
    log: "logs/06_aggregate/{sample}.log"
    shell:
        """
        mkdir -p {params.output_dir}
        python workflow/scripts/aggregate_coverage.py \
            {wildcards.sample} \
            {params.input_dir} \
            {params.output_dir} \
            {params.contig_map} \
            &> {log}
        """


# =========================================================================
#          STAGE 7: COMBINE INTO SAMPLE × SPECIES MATRICES
# =========================================================================
# Runs ONCE after ALL per-sample aggregations finish. Produces two matrices:
#   - depth_matrix.csv    (Weighted_Mean_Depth + Weighted_Std_Dev_Depth)
#   - coverage_matrix.csv (Weighted_Mean_Coverage + Weighted_Std_Dev_Coverage)
#
# Rows = samples, columns = Sample_ID + {species}_mean + {species}_std.
# Species order is fixed by the contig_to_species mapping file.
# =========================================================================

rule combine_matrices:
    """Combine all per-sample CSVs into sample × species matrices."""
    input:
        csvs = expand(f"{RESULTS}/aggregated/{{sample}}_depth_and_coverage_stats.csv",
                       sample=SAMPLES),
    output:
        depth    = f"{RESULTS}/matrices/depth_matrix.csv",
        coverage = f"{RESULTS}/matrices/coverage_matrix.csv",
    params:
        agg_dir    = f"{RESULTS}/aggregated",
        contig_map = config["contig_to_species"],
        out_dir    = f"{RESULTS}/matrices",
    threads: 1
    resources:
        mem_mb         = 32000,
        runtime        = 120,
        slurm_partition = PART_SHARED,
    log: "logs/07_combine/combine_matrices.log"
    shell:
        """
        python workflow/scripts/combine_aggregated_stats.py \
            {params.agg_dir} \
            {params.contig_map} \
            {params.out_dir} \
            &> {log}
        """
