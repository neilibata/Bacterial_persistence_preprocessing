"""
Snakefile — Bacterial Evolution & Health Pipeline
===================================================
End-to-end: SRA accession list → per-species coverage matrices.

Designed to run on ANY SLURM cluster. All cluster-specific settings
(partitions, accounts, thread counts) are read from config/config.yaml.

Submit the orchestrator with:
    sbatch run_pipeline.sh

Or from a tmux/screen session:
    bash run_pipeline.sh
"""

# =========================================================================
# Configuration
# =========================================================================
configfile: "config/config.yaml"

import os
import re
import datetime

# =========================================================================
# Read cluster settings from config
# =========================================================================
PART_CPU      = config.get("partition_cpu",      "shared")
PART_SHARED   = config.get("partition_shared",   "shared")
PART_DOWNLOAD = config.get("partition_download", PART_CPU)
SLURM_ACCOUNT = config.get("slurm_account",     "")

ALIGN_THREADS   = int(config.get("align_threads",      16))
PREPROC_THREADS = int(config.get("preprocess_threads", 8))

# Partition for memory-hungry work on large samples. FASRC `shared` gives
# 3.6 GB/core (48c/172GB); `sapphire` gives 8.8 GB/core (112c/990GB), which is
# what the long tail of deeply-sequenced samples needs.
PART_BIGMEM   = config.get("partition_bigmem",  "sapphire")
BIG_SAMPLE_MB = int(config.get("big_sample_mb", 15000))


def capped_runtime(minutes):
    """Clamp a runtime estimate to something sbatch will accept.

    Every runtime here is a linear extrapolation from input size or run count,
    and every one of them is generous: SRR549749's align was estimated at 1,447
    minutes and finished in 118. That over-estimate is harmless until it crosses
    the partition's own limit, at which point sbatch rejects the job outright
    with "Requested time limit is invalid" -- and because the shell never runs,
    the rule's log is zero bytes and the failure looks nothing like its cause.

    Worse, Snakemake's retry multiplies the estimate by the attempt number, so a
    request that was rejected for being too long is resubmitted at 2x and 3x. It
    can never recover; it just fails three times and takes the workflow down.

    This bit sra_download once (SRR549749, 38 runs -> 4,560 min) and the cap was
    added there only. It then bit align on SAMEA4765588, the deepest sample in
    Carter 2023 at 209 Gbp -- 66 GB of repaired FASTQ / 12 = 5,679 min, against
    the 3-day (4,320 min) ceiling every FASRC Cannon partition enforces. One
    sample in 468. Hence a single shared helper rather than a per-rule fix, and
    hence the clamp AFTER the attempt multiplier rather than before it.

    Check your own cluster with `sinfo -o "%.20P %.12l"` before raising it.
    """
    ceiling = int(config.get("max_runtime_min", 4200))
    return max(10, min(ceiling, int(minutes)))


def part_by_size(wc, input):
    """Send large inputs to the high-memory-per-core partition."""
    try:
        return PART_BIGMEM if input.size_mb > BIG_SAMPLE_MB else PART_CPU
    except Exception:
        return PART_CPU


def align_mem(wc, input, attempt):
    """Bowtie2 memory is dominated by the resident index, not the read count.

    The index is constant (~9 GB for a 3,600-genome catalogue, more for larger
    ones) and reads are streamed, so alignment memory is essentially flat in
    sample size. Only `samtools sort` scales, and that is capped by -m x threads.
    The previous `input.size_mb * 5` model under-provisioned large samples --
    20 GB against a ~9 GB index plus 8 GB of sort buffers is close enough to the
    limit to be OOM-killed, which removes the sample silently under --keep-going.
    """
    return int(config.get("align_mem_mb", 40000)) * attempt


def decontam_mem(wc, input, attempt):
    """Bowtie2 decontamination memory is flat in sample size, like alignment.

    The resident index dominates (~4 GB for hg38) and reads are streamed, so
    scaling the request with the input was wrong in the same way `align_mem`
    documents. It only became visible on the largest sample in the cohort:
    SAMEA4765588 has 1.48 billion reads, whose phiX-removed FASTQs made
    `input.size_mb * 3` request 180-300 GB. No node in the `shared` partition
    has that much, so the job could not run and the sample was lost silently
    under --keep-going.
    """
    return int(config.get("decontam_mem_mb", 24000)) * attempt


def repair_mem(wc, input, attempt):
    """repair.sh buffers reads to re-pair them, so this one genuinely scales."""
    return int(max(32000, input.size_mb * 4)) * attempt

# =========================================================================
# Intermediate file cleanup
# =========================================================================
# By default, intermediate files are deleted after downstream rules succeed.
# Repaired reads, coverage files, and final outputs are always kept.
# Set keep_all: true in config.yaml to disable cleanup entirely.
# =========================================================================
KEEP_ALL = config.get("keep_all", False)
KEEP_REPAIRED_READS = config.get("keep_repaired_reads", True)
KEEP_FILTERED_BAMS = config.get("keep_filtered_bams", True)

def intermediate(path):
    """Mark a file for automatic deletion after it's no longer needed.
    Disabled when keep_all: true is set in config."""
    return path if KEEP_ALL else temp(path)

def checkpoint(path, keep_flag):
    """Mark a file as a configurable checkpoint.
    Kept when keep_flag is True or keep_all is True; otherwise temp."""
    return path if (keep_flag or KEEP_ALL) else temp(path)

# =========================================================================
# Sample discovery
# =========================================================================
# Two file formats are accepted, detected per line:
#
#   1. sample_id <TAB> run1;run2;run3      explicit sample -> runs mapping
#   2. anything containing accessions      each accession is its own sample
#
# Format 2 is the original behaviour and still works unchanged. Format 1 exists
# because a biological sample is frequently sequenced across several SRA runs
# (16% of this cohort; up to 35 runs for one sample). Those runs must be
# concatenated BEFORE alignment: aligning them separately produces one matrix
# row per run, and the analysis keys on one row per sample. The merge cannot be
# done afterwards -- breadth is a percentage of genome covered, so per-run
# breadths cannot be pooled without the underlying alignments.
#
# Lines starting with # and a `sample_id` header line are ignored.
# =========================================================================
SAMPLES_TSV = config["samples_tsv"]
SRA_PATTERN = re.compile(r'\b([SED]RR\d{6,})\b')

def load_samples():
    """Parse the samples file into an ordered {sample_id: [run, ...]} map."""
    samples = {}
    with open(SAMPLES_TSV) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if re.match(r'^sample[_ ]?id\b', line, re.IGNORECASE):
                continue                                   # header row
            parts = re.split(r'[\t,]', line, maxsplit=1)
            if len(parts) == 2 and SRA_PATTERN.search(parts[1]):
                sid = parts[0].strip()
                runs = SRA_PATTERN.findall(parts[1])
                if sid and runs:
                    samples.setdefault(sid, runs)
                    continue
            # Fall back: every accession on the line is a single-run sample.
            for match in SRA_PATTERN.findall(line):
                samples.setdefault(match, [match])
    return samples

def validate_contig_map(path):
    """Fail fast if the map's species column is actually contig-level.

    `aggregate_coverage.py` treats column 1 as the species and column 2 as the
    contig. A map whose column 1 carries contig identifiers parses without
    error and produces a matrix with one column per contig instead of per
    species -- 251,424 columns rather than 3,971 in the case that prompted this
    check. Nothing downstream notices; the matrix is simply the wrong shape,
    and it is only caught when someone compares it to a matrix built correctly.

    The signature is unmistakable: a species column with nearly as many
    distinct values as the contig column.
    """
    species, contigs, rows = set(), set(), 0
    with open(path) as fh:
        for line in fh:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 3:
                parts = line.split()
            if len(parts) < 3:
                continue
            species.add(parts[0]); contigs.add(parts[1]); rows += 1
    if not rows:
        raise WorkflowError(f"contig map {path} contains no usable rows")
    ratio = len(species) / len(contigs)
    print(f"[Pipeline] contig map: {len(species):,} species over "
          f"{len(contigs):,} contigs ({rows:,} rows)")
    if ratio > 0.5:
        raise WorkflowError(
            f"contig map {path} looks contig-level, not species-level: "
            f"{len(species):,} distinct values in the species column against "
            f"{len(contigs):,} contigs. Column 1 must be the species/SGB "
            f"identifier and column 2 the contig.")

# =========================================================================
# Reference catalogues
# =========================================================================
# One reference (legacy) or several (multi-reference mode).
#
#   reference_fasta:   resources/ref.fna          # legacy, unchanged
#   contig_to_species: resources/contig.tsv
#
#   references:                                    # multi-reference mode
#     UHGG: {fasta: resources/uhgg.fna, contig_to_species: resources/uhgg.tsv}
#     lev:  {fasta: resources/lev.fna,  contig_to_species: resources/lev.tsv}
#
# Everything upstream of alignment -- download, trim, PhiX, host removal,
# repair -- is reference-independent and is the bulk of the runtime. Running it
# once per reference repeats that work for no gain. In multi-reference mode the
# shared stages run once and each reference consumes the same repaired FASTQs.
#
# The repaired reads are released only after the LAST reference has aligned
# them: Snakemake's temp() deletes a file when no pending job still needs it,
# so `keep_repaired_reads: false` gives exactly the requested behaviour --
# align against every reference, then delete -- with no extra bookkeeping.
# =========================================================================
if config.get("references"):
    REFERENCES = {str(k): dict(v) for k, v in config["references"].items()}
    MULTI_REF  = True

    # Run a subset without editing the reference table:
    #     --config only_refs=UHGG
    #     --config only_refs=UHGG,lev
    # The per-reference directory layout is KEPT when subsetting, so a later run
    # of the other reference lands beside the first instead of colliding with
    # it. Selecting a subset is a scheduling decision, not a layout change --
    # dropping to the legacy flat layout here would mean the second reference
    # overwrote the first's matrices.
    _only = config.get("only_refs") or config.get("only_ref")
    if _only:
        if isinstance(_only, str):
            _wanted = [x.strip() for x in _only.replace(";", ",").split(",") if x.strip()]
        else:
            _wanted = [str(x) for x in _only]
        _unknown = [r for r in _wanted if r not in REFERENCES]
        if _unknown:
            raise WorkflowError(
                f"only_refs names {_unknown} which are not in the references "
                f"table (have: {sorted(REFERENCES)})")
        REFERENCES = {k: v for k, v in REFERENCES.items() if k in _wanted}
        if not REFERENCES:
            raise WorkflowError("only_refs selected no references")
else:
    REFERENCES = {"__single__": {
        "fasta":             config["reference_fasta"],
        "contig_to_species": config["contig_to_species"],
    }}
    MULTI_REF = False

REF_NAMES = list(REFERENCES)
print(f"[Pipeline] references: {', '.join(REF_NAMES)}"
      + ("" if MULTI_REF else "  (legacy single-reference layout)"))
for _name, _spec in REFERENCES.items():
    if "fasta" not in _spec or "contig_to_species" not in _spec:
        raise WorkflowError(
            f"reference {_name!r} needs both 'fasta' and 'contig_to_species'")
    validate_contig_map(_spec["contig_to_species"])

def ref_dir(base):
    """Insert a per-reference level only in multi-reference mode, so existing
    single-reference result trees resume unchanged."""
    return f"{base}/{{ref}}" if MULTI_REF else base

def ref_log(path):
    """Log path for a per-reference rule.

    Snakemake requires every output, log and benchmark of a rule to carry the
    same wildcards, so a rule whose outputs gained {ref} must have it in the
    log too -- otherwise two references would write to one log and the rule is
    rejected at DAG construction.
    """
    return f"logs/{{ref}}/{path}" if MULTI_REF else f"logs/{path}"


def ref_tag(name):
    """Filename component for a reference; empty in single-reference mode."""
    return f"_{name}" if MULTI_REF else ""

def contig_map_for(wildcards):
    name = getattr(wildcards, "ref", None) or REF_NAMES[0]
    return REFERENCES[name]["contig_to_species"]

def fasta_for(wildcards):
    name = getattr(wildcards, "ref", None) or REF_NAMES[0]
    return REFERENCES[name]["fasta"]

SAMPLE_RUNS = load_samples()
SAMPLES     = list(SAMPLE_RUNS)
_N_MULTI    = sum(1 for r in SAMPLE_RUNS.values() if len(r) > 1)
_N_RUNS     = sum(len(r) for r in SAMPLE_RUNS.values())
print(f"[Pipeline] {len(SAMPLES)} samples auto-detected from {SAMPLES_TSV}")
if _N_MULTI:
    print(f"[Pipeline] {_N_MULTI} are multi-run; {_N_RUNS} runs will be "
          f"downloaded and concatenated per sample")

# Sample IDs are not always accessions (e.g. "FAT_006-22-0-0"), so constrain the
# wildcard to the known set rather than letting it match greedily into suffixes.
wildcard_constraints:
    sample = "|".join(re.escape(s) for s in SAMPLES) if SAMPLES else r"[^/]+",
    ref    = "|".join(re.escape(r) for r in REF_NAMES),


# =========================================================================
# Derived paths
# =========================================================================
# Each run writes its own dated matrix shard rather than overwriting one file.
# Column order is fixed by contig_to_species, so shards are column-identical and
# concatenate safely -- a backfill of a few hundred samples never has to rebuild,
# or risk, the samples already processed.
MATRIX_VERSION = config.get("matrix_version",
                            datetime.date.today().strftime("%Y%m%d"))

RESULTS   = config.get("results_dir", "results")
REF_DIR   = f"{RESULTS}/references"
FASTQ_DIR = f"{RESULTS}/fastq"
PHIX_IDX  = f"{REF_DIR}/phix/phix"
HUMAN_IDX = f"{REF_DIR}/human/hg38"
META_IDX  = (f"{REF_DIR}/metagenome/{{ref}}/reference" if MULTI_REF
             else f"{REF_DIR}/metagenome/reference")
META_SENT = (f"{REF_DIR}/metagenome/{{ref}}/.index_done" if MULTI_REF
             else f"{REF_DIR}/metagenome/.index_done")


# =========================================================================
# TARGET — the final outputs
# =========================================================================
def _targets():
    """Final outputs, once per configured reference."""
    out = []
    for ref in REF_NAMES:
        agg  = f"{RESULTS}/aggregated/{ref}" if MULTI_REF else f"{RESULTS}/aggregated"
        mat  = f"{RESULTS}/matrices/{ref}"   if MULTI_REF else f"{RESULTS}/matrices"
        out += expand(f"{agg}/{{sample}}_depth_and_coverage_stats.csv",
                      sample=SAMPLES)
        out += [
            f"{mat}/depth_matrix_{MATRIX_VERSION}.csv",
            f"{mat}/coverage_matrix_{MATRIX_VERSION}.csv",
            f"{mat}/depth_matrix.csv",
            f"{mat}/coverage_matrix.csv",
            f"{mat}/completeness_report.tsv",
        ]
    out += [f"{RESULTS}/provenance/software_versions_{MATRIX_VERSION}.txt"]
    return out


rule all:
    input:
        _targets(),


# =========================================================================
#               REFERENCE PREPARATION (runs once)
# =========================================================================
# These five rules download reference genomes and build Bowtie2 indices.
# They run exactly once. On re-runs, Snakemake sees outputs exist and skips.
# If you already have indices, create the sentinel files:
#     mkdir -p results/references/{phix,human,metagenome}
#     touch results/references/{phix,human,metagenome}/.index_done
# =========================================================================

rule download_phix:
    """Download PhiX174 genome from NCBI."""
    output: fasta = f"{REF_DIR}/phix/phix.fna"
    params:
        url = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/819/615/GCF_000819615.1_ViralProj14015/GCF_000819615.1_ViralProj14015_genomic.fna.gz",
    resources:
        mem_mb    = 2000,
        runtime   = 30,
        slurm_partition = PART_DOWNLOAD,
    log: "logs/ref/download_phix.log"
    shell:
        """
        mkdir -p $(dirname {output.fasta})
        curl -fSL {params.url} 2> {log} | gunzip -c > {output.fasta}
        """


rule build_phix_index:
    input:  fasta = f"{REF_DIR}/phix/phix.fna"
    output: sentinel = f"{REF_DIR}/phix/.index_done"
    params: idx = PHIX_IDX
    threads: 4
    resources:
        mem_mb    = 4000,
        runtime   = 30,
        slurm_partition = PART_CPU,
    log: "logs/ref/build_phix.log"
    shell:
        """
        bowtie2-build --threads {threads} {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


rule download_human:
    """Download GRCh38 (hg38) from NCBI. ~3 GB compressed, ~3.1 GB uncompressed."""
    output: fasta = f"{REF_DIR}/human/hg38.fna"
    params:
        url = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/405/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.fna.gz",
    resources:
        mem_mb    = 4000,
        runtime   = 120,
        slurm_partition = PART_DOWNLOAD,
    log: "logs/ref/download_human.log"
    shell:
        """
        mkdir -p $(dirname {output.fasta})
        curl -fSL {params.url} 2> {log} | gunzip -c > {output.fasta}
        """


rule build_human_index:
    """Build hg38 Bowtie2 large index. ~2-3 hours, ~60 GB RAM, runs once."""
    input:  fasta = f"{REF_DIR}/human/hg38.fna"
    output: sentinel = f"{REF_DIR}/human/.index_done"
    params: idx = HUMAN_IDX
    threads: 8
    resources:
        mem_mb    = 65000,
        runtime   = 300,
        slurm_partition = PART_CPU,
    log: "logs/ref/build_human.log"
    shell:
        """
        bowtie2-build --threads {threads} --large-index \
            {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


rule build_metagenome_index:
    """Build a Bowtie2 large index per reference catalogue."""
    input:  fasta = fasta_for
    output: sentinel = META_SENT
    params: idx = META_IDX
    threads: 8
    resources:
        mem_mb    = 65000,
        runtime   = 300,
        slurm_partition = PART_CPU,
    log: ref_log("ref/build_metagenome.log")
    shell:
        """
        mkdir -p $(dirname {params.idx})
        bowtie2-build --threads {threads} --large-index \
            {input.fasta} {params.idx} &> {log}
        touch {output.sentinel}
        """


# =========================================================================
#                   STAGE 1: SRA DOWNLOAD
# =========================================================================
# One job per sample. prefetch → fasterq-dump → pigz.
# Uses the "download" partition (may need internet access).
# If you already have FASTQs, symlink them into results/fastq/ and these
# rules are skipped automatically.
# =========================================================================

rule sra_download:
    """Fetch every run of a sample and concatenate the paired-end ones.

    Delegates to workflow/scripts/fetch_runs.py, which looks a run's layout up
    in ENA rather than inferring it from which files fasterq-dump happened to
    emit. That distinction matters: ERR1913111 is PAIRED in ENA with 16.5M
    reads but comes back single-end through SRA's Normalized Format, and the
    previous inline version silently dropped it -- along with every other run
    of that sample -- producing an all-zero coverage row with no error.
    """
    output:
        r1 = intermediate(f"{FASTQ_DIR}/{{sample}}_1.fastq.gz"),
        r2 = intermediate(f"{FASTQ_DIR}/{{sample}}_2.fastq.gz"),
    params:
        fastq_dir = FASTQ_DIR,
        qc_dir    = f"{RESULTS}/qc",
        prefer    = config.get("download_source", "sra"),
        max_size  = config.get("prefetch_max_size", "300G"),
        runs      = lambda wc: " ".join(SAMPLE_RUNS[wc.sample]),
        n_runs    = lambda wc: len(SAMPLE_RUNS[wc.sample]),
    threads: 6
    retries: 2
    resources:
        mem_mb    = lambda wc, attempt: 10000 * attempt,
        # Download+convert+compress is roughly linear in run count, so a sample
        # with 10 runs needs far more than the 5 h a single run does.
        # 120 min per run is a linear estimate, so a many-run sample asks for
        # more time than any partition allows and sbatch refuses the job
        # outright: "Requested time limit is invalid". The sample then fails
        # for a scheduling reason that looks nothing like its cause, and the
        # log is zero bytes because the shell never ran.
        #
        # SRR549749 has 38 runs -> 4,560 min even on attempt 1. Every FASRC
        # Cannon partition (shared, serial_requeue, sapphire) caps at 3 days =
        # 4,320 min, so all three attempts were rejected. The default below
        # sits under that; raise it only after checking `sinfo -o "%.20P %.12l"`
        # on your own cluster.
        runtime   = lambda wc, attempt: capped_runtime(
                        max(300, 120 * len(SAMPLE_RUNS[wc.sample])) * attempt),
        slurm_partition = PART_DOWNLOAD,
    log: "logs/01_download/{sample}.log"
    shell:
        """
        mkdir -p "$(dirname {log})"
        python workflow/scripts/fetch_runs.py \
            --sample {wildcards.sample} \
            --runs "{params.runs}" \
            --outdir {params.fastq_dir} \
            --tmpdir {params.fastq_dir}/.tmp_{wildcards.sample} \
            --qc-dir {params.qc_dir} \
            --threads {threads} \
            --max-size {params.max_size} \
            --prefer {params.prefer} \
            &> {log}
        """


# =========================================================================
#                   STAGE 2: PREPROCESSING
# =========================================================================
# trim_galore → bowtie2 vs PhiX → bowtie2 vs hg38 → BBTools repair
#
# Each step is a separate rule for:
#   - Independent failure/retry (OOM in human removal doesn't redo trimming)
#   - Automatic resource scaling per step
#   - intermediate() cleanup (safe: only after downstream succeeds)
#     Disabled when keep_all: true in config.yaml
# =========================================================================

rule trim_galore:
    """Adapter + quality trimming."""
    input:
        r1 = f"{FASTQ_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{FASTQ_DIR}/{{sample}}_2.fastq.gz",
    output:
        r1 = intermediate(f"{RESULTS}/trimmed/{{sample}}_1_val_1.fq.gz"),
        r2 = intermediate(f"{RESULTS}/trimmed/{{sample}}_2_val_2.fq.gz"),
    params:
        outdir = f"{RESULTS}/trimmed",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 2)) * attempt,
        runtime   = lambda wc, input, attempt: capped_runtime(max(60,   int(input.size_mb / 80)) * attempt),
        slurm_partition = PART_CPU,
    log: "logs/02_trim/{sample}.log"
    shell:
        """
        mkdir -p {params.outdir}
        trim_galore -j {threads} --paired \
            --output_dir {params.outdir} \
            {input.r1} {input.r2} \
            &> {log}
        """


rule remove_phix:
    """Remove PhiX spike-in contamination."""
    input:
        r1       = f"{RESULTS}/trimmed/{{sample}}_1_val_1.fq.gz",
        r2       = f"{RESULTS}/trimmed/{{sample}}_2_val_2.fq.gz",
        idx_done = f"{REF_DIR}/phix/.index_done",
    output:
        r1 = intermediate(f"{RESULTS}/decontam/{{sample}}_1_phiX_removed.fq.gz"),
        r2 = intermediate(f"{RESULTS}/decontam/{{sample}}_2_phiX_removed.fq.gz"),
    params:
        idx    = PHIX_IDX,
        prefix = f"{RESULTS}/decontam/{{sample}}_%_phiX_removed.fq.gz",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        mem_mb    = decontam_mem,
        runtime   = lambda wc, input, attempt: capped_runtime(max(30,   int(input.size_mb / 80)) * attempt),
        slurm_partition = part_by_size,
    log: "logs/02_phix/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {params.prefix})
        bowtie2 -p {threads} \
            --un-conc-gz {params.prefix} \
            -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --no-unal \
            > /dev/null 2> {log}
        """


rule remove_human:
    """Remove human host reads by aligning to hg38."""
    input:
        r1       = f"{RESULTS}/decontam/{{sample}}_1_phiX_removed.fq.gz",
        r2       = f"{RESULTS}/decontam/{{sample}}_2_phiX_removed.fq.gz",
        idx_done = f"{REF_DIR}/human/.index_done",
    output:
        r1 = intermediate(f"{RESULTS}/decontam/{{sample}}_1_human_removed.fq.gz"),
        r2 = intermediate(f"{RESULTS}/decontam/{{sample}}_2_human_removed.fq.gz"),
    params:
        idx    = HUMAN_IDX,
        prefix = f"{RESULTS}/decontam/{{sample}}_%_human_removed.fq.gz",
    threads: PREPROC_THREADS
    retries: 2
    resources:
        # Human genome alignment needs more memory than PhiX
        mem_mb    = decontam_mem,
        runtime   = lambda wc, input, attempt: capped_runtime(max(120,   int(input.size_mb / 50)) * attempt),
        slurm_partition = part_by_size,
    log: "logs/02_human/{sample}.log"
    shell:
        """
        bowtie2 -p {threads} \
            --un-conc-gz {params.prefix} \
            -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --no-unal \
            > /dev/null 2> {log}
        """


rule repair_mates:
    """Re-synchronize mate pairs after decontamination."""
    input:
        r1 = f"{RESULTS}/decontam/{{sample}}_1_human_removed.fq.gz",
        r2 = f"{RESULTS}/decontam/{{sample}}_2_human_removed.fq.gz",
    output:
        # Configurable checkpoint — kept by default for re-alignment flexibility
        r1 = checkpoint(f"{RESULTS}/repaired/{{sample}}_1_repaired.fq.gz", KEEP_REPAIRED_READS),
        r2 = checkpoint(f"{RESULTS}/repaired/{{sample}}_2_repaired.fq.gz", KEEP_REPAIRED_READS),
    params:
        singles_tmp = f"{RESULTS}/repaired/{{sample}}_singles.fq.gz",
    threads: 4
    retries: 2
    resources:
        mem_mb    = repair_mem,
        runtime   = lambda wc, input, attempt: capped_runtime(max(60,   int(input.size_mb / 60)) * attempt),
        slurm_partition = part_by_size,
    log: "logs/02_repair/{sample}.log"
    shell:
        """
        mkdir -p $(dirname {output.r1})
        # BBTools is a JVM app: without -Xmx it sizes the heap from NODE memory
        # (172 GB on a shared node) and is then OOM-killed by the cgroup at the
        # requested limit. Cap it just under what SLURM actually granted.
        XMX_MB=$(( {resources.mem_mb} * 85 / 100 ))
        repair.sh -Xmx${{XMX_MB}}m \
            in1={input.r1} in2={input.r2} \
            out1={output.r1} out2={output.r2} \
            outs={params.singles_tmp} \
            qin=33 \
            &> {log}

        # If the mates were out of register, repair.sh classifies nearly every
        # read as a singleton and the paired outputs come back as empty gzip
        # members (~28 bytes). Deleting the singles file then destroys the
        # evidence, and the sample proceeds to align nothing and aggregate to a
        # row of zeros. Fail here instead, while the cause is still visible.
        for f in {output.r1} {output.r2}; do
            if [ "$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f")" -lt 1000 ]; then
                echo "ERROR: $f is empty after repair - mates were almost" \
                     "certainly out of register. Singles retained for" \
                     "diagnosis at {params.singles_tmp}" >> {log}
                exit 1
            fi
        done

        # Remove singles file — empty for properly paired data
        rm -f {params.singles_tmp}
        """


# =========================================================================
#                     STAGE 3: ALIGNMENT
# =========================================================================
# Bowtie2 --very-sensitive-local piped directly to samtools sort.
# No intermediate SAM on disk (saves massive disk space).
# =========================================================================

rule align:
    """Align cleaned reads to metagenome reference → sorted BAM (no intermediate SAM)."""
    input:
        r1       = f"{RESULTS}/repaired/{{sample}}_1_repaired.fq.gz",
        r2       = f"{RESULTS}/repaired/{{sample}}_2_repaired.fq.gz",
        idx_done = META_SENT,
    output:
        bam = intermediate(f"{ref_dir(RESULTS + '/aligned')}/{{sample}}.sorted.bam"),
        bai = intermediate(f"{ref_dir(RESULTS + '/aligned')}/{{sample}}.sorted.bam.bai"),
    params:
        idx = META_IDX,
    threads: ALIGN_THREADS
    retries: 2
    resources:
        mem_mb    = align_mem,
        runtime   = lambda wc, input, attempt: capped_runtime(max(180,   int(input.size_mb / 12)) * attempt),
        slurm_partition = part_by_size,
    log: ref_log("03_align/{sample}.log")
    shell:
        # Pipe: bowtie2 → samtools view → samtools sort
        # samtools gets 4 threads each; bowtie2 gets the rest
        """
        set -o pipefail

        # Thread budget: bowtie2 gets {threads}-6, samtools gets 3+3. Previously
        # bowtie2 took all {threads} while samtools took another 8 on top, so a
        # 20-core allocation was asked to run 28 threads.
        BT2_THREADS=$(( {threads} - 6 )); [ "$BT2_THREADS" -lt 1 ] && BT2_THREADS=1

        # --mm memory-maps the index so concurrent jobs on one node share a
        # single copy in page cache. No effect on output.
        (bowtie2 -x {params.idx} \
            -1 {input.r1} -2 {input.r2} \
            --very-sensitive-local \
            --mm \
            -p "$BT2_THREADS" \
        | samtools view -Sb --threads 3 - \
        | samtools sort -o {output.bam} --threads 3 -m 1G \
        ) 2> {log}

        samtools index -@ 3 {output.bam} 2>> {log}
        """


# =========================================================================
#                   STAGE 4: MAPQ FILTERING
# =========================================================================
# Single-pass MAPQ split: high (≥ threshold) and low (< threshold).
# Uses samtools view -q with -U for the complement — one read of the BAM.
# =========================================================================

rule filter_mapq:
    """Single-pass BAM split into high/low MAPQ."""
    input:
        bam = f"{ref_dir(RESULTS + '/aligned')}/{{sample}}.sorted.bam",
    output:
        high = checkpoint(f"{ref_dir(RESULTS + '/filtered')}/high/{{sample}}_high_mapq.bam", KEEP_FILTERED_BAMS),
        low  = checkpoint(f"{ref_dir(RESULTS + '/filtered')}/low/{{sample}}_low_mapq.bam", KEEP_FILTERED_BAMS),
    params:
        mapq = config.get("mapq_threshold", 30),
    threads: 4
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(8000, int(input.size_mb * 1.5)) * attempt,
        runtime   = lambda wc, input, attempt: capped_runtime(max(30,   int(input.size_mb / 200)) * attempt),
        slurm_partition = PART_SHARED,
    log: ref_log("04_filter/{sample}.log")
    shell:
        """
        mkdir -p $(dirname {output.high}) $(dirname {output.low})
        samtools view -b -q {params.mapq} \
            -U {output.low} \
            -o {output.high} \
            {input.bam} \
            2> {log}
        samtools quickcheck {output.high} {output.low} 2>> {log}
        """


# =========================================================================
#               STAGE 5: COVERAGE EXTRACTION
# =========================================================================
# samtools coverage → per-contig depth + breadth of coverage.
# Uses {tier} wildcard to handle both "high" and "low" with one rule.
# Coverage files are always kept (small; useful for downstream analysis).
# =========================================================================

rule extract_coverage:
    """Per-contig coverage statistics with samtools coverage."""
    input:
        bam = f"{ref_dir(RESULTS + '/filtered')}/{{tier}}/{{sample}}_{{tier}}_mapq.bam",
    output:
        cov = f"{ref_dir(RESULTS + '/coverage')}/{{tier}}/{{sample}}_{{tier}}_mapq_coverage.txt",
    threads: 1
    retries: 2
    resources:
        mem_mb    = lambda wc, input, attempt: max(4000, int(input.size_mb * 1.5)) * attempt,
        runtime   = lambda wc, input, attempt: capped_runtime(max(30,   int(input.size_mb / 100)) * attempt),
        slurm_partition = PART_SHARED,
    log: ref_log("05_coverage/{tier}/{sample}.log")
    shell:
        """
        mkdir -p $(dirname {output.cov})
        samtools quickcheck -v {input.bam} 2> {log}
        samtools coverage -o {output.cov} {input.bam} 2>> {log}
        """


# =========================================================================
#             STAGE 6: COVERAGE AGGREGATION
# =========================================================================
# Python: aggregates contig-level → species-level with length weighting.
# Very lightweight — mostly pandas operations in memory.
# =========================================================================

rule aggregate_coverage:
    """Aggregate per-contig coverage to per-species weighted statistics."""
    input:
        cov = f"{ref_dir(RESULTS + '/coverage')}/high/{{sample}}_high_mapq_coverage.txt",
    output:
        csv = f"{ref_dir(RESULTS + '/aggregated')}/{{sample}}_depth_and_coverage_stats.csv",
    params:
        contig_map = contig_map_for,
        input_dir  = f"{ref_dir(RESULTS + '/coverage')}/high",
        output_dir = ref_dir(RESULTS + "/aggregated"),
    threads: 1
    resources:
        mem_mb    = 16000,
        runtime   = 60,
        slurm_partition = PART_SHARED,
    log: ref_log("06_aggregate/{sample}.log")
    shell:
        """
        mkdir -p {params.output_dir}
        python workflow/scripts/aggregate_coverage.py \
            {wildcards.sample} \
            {params.input_dir} \
            {params.output_dir} \
            {params.contig_map} \
            &> {log}
        """


# =========================================================================
#          STAGE 7: COMBINE INTO SAMPLE × SPECIES MATRICES
# =========================================================================
# Runs ONCE after ALL per-sample aggregations finish. Produces two matrices:
#   - depth_matrix.csv    (Weighted_Mean_Depth + Weighted_Std_Dev_Depth)
#   - coverage_matrix.csv (Weighted_Mean_Coverage + Weighted_Std_Dev_Coverage)
#
# Rows = samples, columns = Sample_ID + {species}_mean + {species}_std.
# Species order is fixed by the contig_to_species mapping file.
# =========================================================================

rule combine_matrices:
    """Combine all per-sample CSVs into sample × species matrices."""
    input:
        csvs = lambda wc: expand(
            f"{ref_dir(RESULTS + '/aggregated')}/{{sample}}_depth_and_coverage_stats.csv",
            sample=SAMPLES, **({"ref": wc.ref} if MULTI_REF else {})),
    output:
        depth    = f"{ref_dir(RESULTS + '/matrices')}/depth_matrix_{MATRIX_VERSION}.csv",
        coverage = f"{ref_dir(RESULTS + '/matrices')}/coverage_matrix_{MATRIX_VERSION}.csv",
    params:
        agg_dir    = ref_dir(RESULTS + "/aggregated"),
        contig_map = contig_map_for,
        out_dir    = ref_dir(RESULTS + "/matrices"),
        version    = MATRIX_VERSION,
    threads: 1
    resources:
        mem_mb         = 32000,
        runtime        = 120,
        slurm_partition = PART_SHARED,
    log: ref_log("07_combine/combine_matrices.log")
    shell:
        """
        python workflow/scripts/combine_aggregated_stats.py \
            --shard {params.version} \
            {params.contig_map} \
            {params.out_dir} \
            {input.csvs} \
            &> {log}
        """


# =========================================================================
#          STAGE 8: COMPLETENESS VERIFICATION
# =========================================================================
# Asserts that every accession in samples_tsv reached the final matrix. Without
# this a sample can fail anywhere upstream and simply be absent, with the run
# still reporting success.
# =========================================================================

rule verify_completeness:
    """Fail the run if any requested accession is missing from the matrix."""
    input:
        matrix  = f"{ref_dir(RESULTS + '/matrices')}/depth_matrix_{MATRIX_VERSION}.csv",
        samples = SAMPLES_TSV,
    output:
        report = f"{ref_dir(RESULTS + '/matrices')}/completeness_report.tsv",
    threads: 1
    resources:
        mem_mb          = 4000,
        runtime         = 15,
        slurm_partition = PART_SHARED,
    log: ref_log("08_verify/completeness.log")
    shell:
        """
        python workflow/scripts/verify_completeness.py \
            {input.samples} {input.matrix} {output.report} \
            2>&1 | tee {log}
        """


# =========================================================================
#          STAGE 9: MERGE SHARDS INTO THE CANONICAL MATRIX
# =========================================================================
# Concatenates every dated shard into the canonical matrices. Safe because
# shards share a column order fixed by contig_to_species; the merge refuses on
# header mismatch or a duplicated Sample_ID.
# =========================================================================

rule merge_matrix_shards:
    """Concatenate all dated shards into the canonical matrices."""
    input:
        depth_shard = f"{ref_dir(RESULTS + '/matrices')}/depth_matrix_{MATRIX_VERSION}.csv",
        cov_shard   = f"{ref_dir(RESULTS + '/matrices')}/coverage_matrix_{MATRIX_VERSION}.csv",
    output:
        depth    = f"{ref_dir(RESULTS + '/matrices')}/depth_matrix.csv",
        coverage = f"{ref_dir(RESULTS + '/matrices')}/coverage_matrix.csv",
    params:
        mdir = ref_dir(RESULTS + "/matrices"),
    threads: 1
    resources:
        mem_mb          = 8000,
        runtime         = 60,
        slurm_partition = PART_SHARED,
    log: ref_log("09_merge/merge.log")
    shell:
        """
        python workflow/scripts/merge_matrix_shards.py \\
            {output.depth} {params.mdir}/depth_matrix_*.csv &> {log}
        python workflow/scripts/merge_matrix_shards.py \\
            {output.coverage} {params.mdir}/coverage_matrix_*.csv &>> {log}
        """


# =========================================================================
#          STAGE 10: PROVENANCE
# =========================================================================
# Captures git revision, tool versions and the conda environment for this run.
# The original pipeline recorded none of this, so the matrices it produced
# cannot be tied to specific tool builds. Every run from here on is traceable.
# =========================================================================

rule record_provenance:
    """Record git revision, tool versions and conda environment."""
    output:
        txt = f"{RESULTS}/provenance/software_versions_{MATRIX_VERSION}.txt",
    threads: 1
    resources:
        mem_mb          = 2000,
        runtime         = 10,
        slurm_partition = PART_SHARED,
    log: "logs/10_provenance/record.log"
    shell:
        """
        bash workflow/scripts/record_provenance.sh {output.txt} &> {log}
        """
